# Modelo para o piloto fechado (produção na própria máquina + Cloudflare Tunnel).
# Copie para .env, preencha os valores reais e NUNCA comite esse arquivo.
# Veja o runbook em Features/runbook-piloto.md para o passo a passo completo.

# Banco — troque a senha, nunca use "servio".
# Porta 5433 (não 5432) de propósito: evita conflito se você também tiver um Postgres
# nativo rodando na máquina para o ambiente de dev.
POSTGRES_DB=servio
POSTGRES_USER=servio
POSTGRES_PASSWORD=
DB_PORT=5433

# Primeiro acesso: cria paróquia + ADMIN se não houver nenhum usuário.
# Use um e-mail e senha reais, fortes — esta é a conta de administrador do piloto.
SERVIO_ADMIN_EMAIL=
SERVIO_ADMIN_SENHA=
SERVIO_ADMIN_NOME=
SERVIO_PAROQUIA_NOME=

# Aplicação
APP_PORT=8080
SERVIO_FUSO=America/Fortaleza
# URL pública que o cloudflared expõe (ex.: https://algo-aleatorio.trycloudflare.com)
SERVIO_FRONT_URL=
SERVIO_JOBS_ENABLED=true
COOKIE_SECURE=true

# E-mail real via Gmail SMTP (conta com senha de app, não a senha normal da conta)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
# Mesmo endereço do SPRING_MAIL_USERNAME acima
SERVIO_MAIL_FROM=Servio <>

# Porta onde o nginx do front escuta (é o que o cloudflared vai apontar)
WEB_PORT=80
