# Copie para .env e ajuste. Valores aqui são falsos: nunca use estes em produção.

# Banco (docker-compose)
POSTGRES_DB=servio
POSTGRES_USER=servio
POSTGRES_PASSWORD=troque-esta-senha
DB_PORT=5432

# Primeiro acesso: cria paróquia + ADMIN se não houver nenhum usuário
SERVIO_ADMIN_EMAIL=admin@exemplo.com
SERVIO_ADMIN_SENHA=troque-esta-senha-tambem
SERVIO_ADMIN_NOME=Administrador
SERVIO_PAROQUIA_NOME=Paróquia Exemplo

# Conta de demonstração (opcional): ADMIN que vê tudo mas não consegue alterar nada.
# Deixe em branco para não criar.
SERVIO_DEMO_EMAIL=
SERVIO_DEMO_SENHA=
SERVIO_DEMO_NOME=Visitante (somente leitura)

# Mesma ideia, mas com visão de MEMBRO (perfil SERVIDOR). Também opcional.
SERVIO_DEMO_MEMBRO_EMAIL=
SERVIO_DEMO_MEMBRO_SENHA=
SERVIO_DEMO_MEMBRO_NOME=Visitante Membro (somente leitura)

# Aplicação
APP_PORT=8080
SERVIO_FUSO=America/Fortaleza
SERVIO_FRONT_URL=http://localhost:5173
SERVIO_JOBS_ENABLED=true
COOKIE_SECURE=false

# E-mail. Em dev, o Mailpit (docker-compose) recebe tudo e mostra no painel em http://localhost:8025
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_STARTTLS=false
SERVIO_MAIL_FROM=Servio <no-reply@exemplo.com>
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Documentação da API (Swagger UI em /swagger-ui.html, JSON em /v3/api-docs). Ligue só em desenvolvimento.
OPENAPI_ENABLED=true
